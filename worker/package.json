{
  "name": "kenya-quest-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm test && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --format=esm --platform=browser --outfile=dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "deploy:check": "npm test && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.134.0"
  }
}
